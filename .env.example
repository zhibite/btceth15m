# Copy to .env and adjust. Environment variables override config.toml.

# ── Dashboard ───────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8037
WEB_USERNAME=admin
# Set a password before exposing the dashboard publicly.
WEB_PASSWORD=

# ── Mode ────────────────────────────────────────────────────────────────────
# PAPER_TRADING is the default for coins set to "跟随全局" on the config page.
# LIVE_ENABLED is the master switch: a coin explicitly set to 实盘 will only
# place real orders when this is true AND the credentials below are present.
PAPER_TRADING=true
LIVE_ENABLED=false

# ── Live CLOB credentials (only used when LIVE_ENABLED=true) ────────────────
API_KEY=
API_SECRET=
API_PASSPHRASE=
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
FUNDER_ADDRESS=
SIGNATURE_TYPE=0

# ── Optional overrides ──────────────────────────────────────────────────────
# ASSETS=BTC,ETH,BNB,SOL,XRP,DOGE,HYPE
# Market cadence and matching window duration (must agree).
# MARKET_INTERVAL=15m
# WINDOW_SEC=900
# DATA_DIR=./data
# MIN_EDGE=0.05
# MAX_POSITION_USD=5
