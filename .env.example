# Copy to .env and adjust. Environment variables override config.toml.

# ── Dashboard ───────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8036
WEB_USERNAME=admin
# Set a password before exposing the dashboard publicly.
WEB_PASSWORD=

# ── Mode ────────────────────────────────────────────────────────────────────
# Keep PAPER_TRADING=true until the paper results are validated.
PAPER_TRADING=true
LIVE_ENABLED=false

# ── Live CLOB credentials (only used when LIVE_ENABLED=true) ────────────────
API_KEY=
API_SECRET=
API_PASSPHRASE=
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
FUNDER_ADDRESS=
SIGNATURE_TYPE=0

# ── Optional overrides ──────────────────────────────────────────────────────
# ASSETS=BTC,ETH
# DATA_DIR=./data
# MIN_EDGE=0.05
# MAX_POSITION_USD=5
